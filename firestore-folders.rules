// Firestore のルールに追加する部分（資料フォルダ用）
// 「match /databases/{database}/documents {」の内側に貼り付けてください。
// メンバー＝プロフィール登録済みの人。フォルダ・ファイルの編集と削除は、作った本人か取締役会だけ。
    function ebMember() {
      return request.auth != null && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function ebBoard() {
      return ebMember() && ('取締役会' in get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('depts', []));
    }
    match /folders/{id} {
      allow read: if ebMember();
      allow create: if ebMember() && request.resource.data.by == request.auth.uid;
      allow update: if ebMember() && (resource.data.by == request.auth.uid || ebBoard()
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']));
      allow delete: if ebMember() && (resource.data.by == request.auth.uid || ebBoard());
    }
    match /files/{id} {
      allow read: if ebMember();
      allow create: if ebMember() && request.resource.data.by == request.auth.uid;
      allow update, delete: if ebMember() && (resource.data.by == request.auth.uid || ebBoard());
      match /chunks/{c} {
        allow read, create: if ebMember();
        allow delete: if ebMember() && (!exists(/databases/$(database)/documents/files/$(id))
                      || get(/databases/$(database)/documents/files/$(id)).data.by == request.auth.uid || ebBoard());
      }
    }
